{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-live",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_USE_ENV_PROXY=1",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-mock",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_USE_ENV_PROXY=1",
        "YOUCAM_MOCK=1",
        "VISION_MOCK=1",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "dev-mock-render",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_USE_ENV_PROXY=1",
        "YOUCAM_MOCK=1",
        "VISION_MOCK=1",
        "YOUCAM_MOCK_RESULT=test-output/mock-render.png",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "prod",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_USE_ENV_PROXY=1",
        "npm",
        "run",
        "start"
      ],
      "port": 3000
    }
  ]
}
