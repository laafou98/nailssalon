# YouCam API (https://yce.makeupar.com/api-console/en/api-keys/) — server only
YOUCAM_API_KEY=

# DeepSeek (vision extraction) — server only
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-flash

# Local only: fake DeepSeek readings (the user's network blocks api.deepseek.com). Ignored in production builds.
# DEEPSEEK_MOCK=1

# Supabase (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Local only: fake YouCam renders (no units spent). Ignored in production builds.
# YOUCAM_MOCK=1

# YouCam unit caps
UNITS_SESSION_CAP=15
UNITS_GLOBAL_CAP=900
